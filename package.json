{
  "name": "gameplay-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first, game-agnostic QA simulator for controlled gameplay testing.",
  "desktopName": "com.gameplaysimulator.desktop.desktop",
  "main": "out/main/index.js",
  "author": "GameplaySimulator contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "desktop": "node scripts/electron-vite.mjs dev",
    "build": "tsc --noEmit && electron-vite build",
    "example:instrumented-server": "node --experimental-strip-types examples/instrumented-test-server/src/server.ts",
    "package": "node scripts/package.mjs package",
    "dist:linux": "node scripts/package.mjs linux",
    "dist:windows": "node scripts/package.mjs windows",
    "test:packaged": "node scripts/test-packaged-app.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "build": {
    "appId": "com.gameplaysimulator.desktop",
    "productName": "GameplaySimulator",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.d.cts",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.tsx",
      "!node_modules/**/{test,tests,__tests__,benchmark,benchmarks,example,examples,fixtures}/**/*"
    ],
    "extraResources": [
      {
        "from": "build/playwright",
        "to": "playwright",
        "filter": [
          "chromium-*/**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "executableArgs": []
    },
    "appImage": {
      "executableArgs": []
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    }
  }
}
